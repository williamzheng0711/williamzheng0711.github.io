{
  "name": "journeysphere",
  "version": "0.1.0",
  "description": "A reusable land-only visited-region map with a versioned atlas and compact travel state.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./state": "./src/state.js",
    "./style.css": "./src/style.css",
    "./data/*": "./data/*"
  },
  "files": [
    "src",
    "data",
    "scripts",
    "examples",
    "test",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/style.css"
  ],
  "peerDependencies": {
    "leaflet": "^1.9.4"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/geometry.js && node --check src/state.js && npm test",
    "pack:check": "npm pack --dry-run",
    "validate:data": "node scripts/validate-atlas.mjs",
    "build:data": "node scripts/build-atlas.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "polygon-clipping": "0.15.7"
  }
}
